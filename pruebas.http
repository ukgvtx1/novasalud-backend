@baseUrl = http://localhost:3006
@adminToken = PEGA_AQUI_EL_TOKEN_DE_ADMIN
@trabajadorToken = PEGA_AQUI_EL_TOKEN_DE_TRABAJADOR
@productoId = 1

### 1. Listar productos como admin
GET {{baseUrl}}/api/productos?page=1&limit=20

### 10. Buscar clientes
GET {{baseUrl}}/api/clientes?q=María
Authorization: Bearer {{adminToken}}

### 13. Turno actual
GET {{baseUrl}}/api/turnos/actual
Authorization: Bearer {{adminToken}}

### 14. Abrir turno
POST {{baseUrl}}/api/turnos/abrir
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"fondo_inicial": 100.00
}

### 15. Cerrar turno
POST {{baseUrl}}/api/turnos/cerrar
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"efectivo_contado": 100.00
}

### 16. Abrir caja para probar ventas
POST {{baseUrl}}/api/turnos/abrir
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"fondo_inicial": 100.00
}

### 17. Crear venta pagada
POST {{baseUrl}}/api/ventas
Authorization: Bearer {{adminToken}}
Idempotency-Key: venta-prueba-001
Content-Type: application/json

{
	"cliente_id": null,
	"comprobante": "boleta",
	"estado": "pagada",
	"items": [{ "producto_id": 1, "cantidad": 1 }],
	"pagos": [{ "metodo": "efectivo", "monto": 1.00 }]
}

### 18. Listar ventas
GET {{baseUrl}}/api/ventas?page=1&limit=20
Authorization: Bearer {{adminToken}}

### 19. Detalle de venta
GET {{baseUrl}}/api/ventas/1
Authorization: Bearer {{adminToken}}

### 20. Resumen del dashboard
GET {{baseUrl}}/api/resumen
Authorization: Bearer {{adminToken}}

### 11. Crear cliente DNI
POST {{baseUrl}}/api/clientes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"tipo_doc": "DNI",
	"numero_doc": "73456789",
	"nombre": "Ana Sofía Castillo"
}

### 12. Crear cliente RUC
POST {{baseUrl}}/api/clientes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"tipo_doc": "RUC",
	"numero_doc": "20567891234",
	"nombre": "Distribuidora Vida Saludable E.I.R.L."
}
Authorization: Bearer {{adminToken}}

### 2. Buscar y paginar productos
GET {{baseUrl}}/api/productos?q=para&page=1&limit=5
Authorization: Bearer {{adminToken}}

### 3. Crear producto como admin
POST {{baseUrl}}/api/productos
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"codigo": "MED-TEST-001",
	"nombre": "Producto de prueba",
	"presentacion": "Caja x10",
	"precio": 2.50,
	"stock_minimo": 15,
	"requiere_receta": false
}

### 4. Editar producto como admin
PUT {{baseUrl}}/api/productos/{{productoId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"codigo": "MED-TEST-001",
	"nombre": "Producto actualizado",
	"presentacion": "Caja x20",
	"precio": 3.75,
	"stock_minimo": 20,
	"requiere_receta": true
}

### 5. Dar de baja producto como admin
DELETE {{baseUrl}}/api/productos/{{productoId}}
Authorization: Bearer {{adminToken}}

### 6. Reponer lote como admin
POST {{baseUrl}}/api/productos/{{productoId}}/lotes
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"numero_lote": "L2405",
	"vencimiento": "2027-03-31",
	"cantidad": 100
}

### 7. Consultar avisos
GET {{baseUrl}}/api/avisos-stock
Authorization: Bearer {{adminToken}}

### 8. Trabajador no puede crear productos (esperado: 403)
POST {{baseUrl}}/api/productos
Authorization: Bearer {{trabajadorToken}}
Content-Type: application/json

{
	"codigo": "MED-NO-001",
	"nombre": "No autorizado",
	"presentacion": "Unidad",
	"precio": 1,
	"stock_minimo": 1,
	"requiere_receta": false
}

### 9. Sin token (esperado: 401)
GET {{baseUrl}}/api/productos?page=1&limit=20
